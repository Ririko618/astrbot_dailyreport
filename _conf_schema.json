{
  "report_name_cn": {
    "description": "日报名称",
    "type": "string",
    "hint": "显示在日报头部的标题",
    "default": "天依日报"
  },
  "character": {
    "description": "日报角色",
    "type": "string",
    "options": [
      "洛天依",
      "绪山真寻"
    ],
    "hint": "启动时自动扫描 res/role/ 下的文件夹。也可通过下方「导入新角色」上传新角色",
    "default": "洛天依"
  },
  "theme": {
    "description": "日报主题颜色",
    "type": "string",
    "options": [
      "天依蓝",
      "樱花粉",
      "典雅紫",
      "初音绿",
      "暖阳橙"
    ],
    "default": "天依蓝"
  },
  "timezone": {
    "description": "时区",
    "type": "string",
    "options": [
      "Pacific/Auckland",
      "Australia/Sydney",
      "Asia/Tokyo",
      "Asia/Shanghai",
      "Asia/Bangkok",
      "Asia/Kolkata",
      "Asia/Riyadh",
      "Europe/Moscow",
      "Europe/Paris",
      "Europe/London",
      "America/Sao_Paulo",
      "America/New_York",
      "America/Los_Angeles",
      "Pacific/Honolulu"
    ],
    "labels": [
      "UTC+12 奥克兰",
      "UTC+10 悉尼",
      "UTC+9 东京",
      "UTC+8 北京",
      "UTC+7 曼谷",
      "UTC+5:30 印度",
      "UTC+3 利雅得",
      "UTC+3 莫斯科",
      "UTC+1 巴黎",
      "UTC+0 伦敦",
      "UTC-3 圣保罗",
      "UTC-5 纽约",
      "UTC-8 洛杉矶",
      "UTC-10 夏威夷"
    ],
    "default": "Asia/Shanghai"
  },
  "character_upload": {
    "description": "导入新角色",
    "type": "file",
    "hint": "上传 1 个 MD 人格文件 + 若干 PNG 角色图片。MD 文件名即为角色名，所有文件归入同一角色文件夹。如 洛天依.md + 图1.png + 图2.png → res/role/洛天依/",
    "default": []
  },
  "api_token": {
    "description": "ALAPI Token (用于节假日、每日古诗词、早报API)",
    "type": "string",
    "hint": "在 https://www.alapi.cn/ 注册获取Token",
    "obvious_hint": true,
    "default": ""
  },
  "max_anime_count": {
    "description": "今日新番最大显示数量",
    "type": "int",
    "hint": "建议设置为4-8之间",
    "default": 4
  },
  "max_news_count": {
    "description": "新闻最大显示数量",
    "type": "int",
    "hint": "建议设置为5-10之间",
    "default": 5
  },
  "max_hotword_count": {
    "description": "B站热点最大显示数量",
    "type": "int",
    "hint": "建议设置为4-8之间",
    "default": 4
  },
  "max_holiday_count": {
    "description": "摸鱼日历最大显示数量",
    "type": "int",
    "hint": "建议设置为3-5之间",
    "default": 3
  },
  "render_dpr": {
    "description": "渲染清晰度（DPR）",
    "type": "int",
    "hint": "数值越大越清晰，但生成更慢、图片更大；建议 3-6。",
    "default": 5
  },
  "enable_scheduled_push": {
    "description": "是否启用定时推送",
    "type": "bool",
    "hint": "启用后会在指定时间自动推送日报到配置的群组",
    "default": false
  },
  "scheduled_push_time": {
    "description": "定时推送时间 (HH:MM格式，如 08:00)",
    "type": "string",
    "hint": "每日推送时间，24小时制，例如：08:00 表示每天早上8点",
    "default": "08:00"
  },
  "scheduled_push_groups": {
    "description": "定时推送目标群组列表",
    "type": "list",
    "hint": "直接填写群号即可，如：[\"957880653\", \"123456789\"]。也支持 unified_msg_origin 格式",
    "default": []
  },
  "enable_ai_greeting": {
    "description": "是否启用 AI 生成个性化问候语",
    "type": "bool",
    "hint": "启用后 /日报 命令和定时推送都会调用 LLM 生成个性化问候语。关闭则使用预设问候语",
    "default": false
  }
}